# Mode: demo (default, tanpa kunci) atau live
OMNIFORGE_MODE=demo
# Router model (mode live): OpenRouter atau endpoint kompatibel OpenAI
OPENROUTER_API_KEY=
OMNIFORGE_API_BASE=https://openrouter.ai/api/v1
# Transkripsi memo suara (mode live): API kompatibel OpenAI /audio/transcriptions
OPENAI_API_KEY=
# Token platform (mode live, isi yang dipakai saja)
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
SLACK_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SIGNAL_API_BASE=http://127.0.0.1:8080
SIGNAL_NUMBER=
# Backend eksekusi
OMNIFORGE_BACKEND=local
DOCKER_IMAGE=python:3.12-slim
SSH_HOST=
# Port gateway
OMNIFORGE_PORT=8787
